# ── Oturum / güvenlik ───────────────────────────────────────────────
# Zorunlu: JWT çerezlerini imzalamak için rastgele bir anahtar.
# Üretin: openssl rand -base64 32
AUTH_SECRET=

# ── Google ile giriş (isteğe bağlı) ─────────────────────────────────
# https://console.cloud.google.com/apis/credentials → OAuth Client ID (Web application)
# Yetkili yönlendirme adresi: https://SITENIZ/api/auth/callback/google
# (yerelde http://localhost:3000/api/auth/callback/google)
# Boş bırakılırsa yalnızca e-posta + parola girişi görünür.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Kullanıcı deposu (isteğe bağlı) ─────────────────────────────────
# Kullanıcıların (e-posta, parola hash'i, takip listesi, ayarlar) yazıldığı
# JSON dosyası. Varsayılan: data/users.json — bu dosya git'e girmez.
# USERS_FILE=data/users.json

# ── Geliştirme kolaylığı (isteğe bağlı) ─────────────────────────────
# Binance API'sine erişilemeyen ortamlarda (kapalı ağ, CI) arayüzü test
# edebilmek için sentetik "demo" veri üretilir. Arayüzde "DEMO VERİ"
# uyarısı gösterilir. Üretimde KAPALI bırakın.
# DEMO_DATA=1

# Not: Binance piyasa verisi için API anahtarı GEREKMEZ. Uygulama yalnızca
# herkese açık uç noktaları (klines, ticker) okur; emir göndermez.
