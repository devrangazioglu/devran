# ── Sağlayıcı seçimi ────────────────────────────────────────────────
# Uygulama şu sırayla bakar: OPENAI_API_KEY → GEMINI_API_KEY → ANTHROPIC_API_KEY
# OpenAI ücretlidir ama istek limiti çok yüksektir; uzun PDF'ler için önerilir.
# Gemini'nin ücretsiz katmanı vardır ama günlük istek sınırı düşüktür.

# ── OpenAI (ücretli, yüksek limit) ──────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# İsteğe bağlı: model (varsayılan gpt-4.1-mini; sonra gpt-4o, gpt-4o-mini denenir)
# OPENAI_MODEL=gpt-4.1-mini
# İsteğe bağlı: Azure OpenAI veya OpenAI uyumlu başka bir uç nokta
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Ücretsiz seçenek ────────────────────────────────────────────────
# Google AI Studio'dan ücretsiz bir Gemini API anahtarı alın — kredi kartı gerekmez:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: farklı bir Gemini modeli (varsayılan: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Alternatif: Claude (ücretli) ────────────────────────────────────
# GEMINI_API_KEY boşsa bu anahtar kullanılır (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Auth (isteğe bağlı — Google ile giriş)
# https://console.cloud.google.com/apis/credentials adresinden OAuth Client ID oluşturun
# Authorized redirect URI: https://SITENIZ/api/auth/callback/google (yerelde http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rastgele bir gizli anahtar: `openssl rand -base64 32`
AUTH_SECRET=
