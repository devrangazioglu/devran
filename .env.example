# ── Ücretsiz seçenek (önerilen) ─────────────────────────────────────
# Google AI Studio'dan ücretsiz bir Gemini API anahtarı alın — kredi kartı gerekmez:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: farklı bir Gemini modeli (varsayılan: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Alternatif: Claude (ücretli) ────────────────────────────────────
# GEMINI_API_KEY boşsa bu anahtar kullanılır (https://platform.claude.com)
ANTHROPIC_API_KEY=
